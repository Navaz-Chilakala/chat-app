# ---- Required ----
# Postgres 15+ with the pgvector extension. Use the *pooled* connection string on Vercel.
DATABASE_URL=postgres://user:password@host:5432/telecom_ai
# Long random string (>= 32 chars) used to sign nothing secret-bearing but to pepper session tokens.
SESSION_SECRET=replace-with-64-random-characters

# ---- Embeddings (no LLM is used anywhere in this app) ----
# local-hash (default): deterministic, offline, 384-dim feature-hashing embeddings computed in-process.
# openai-compatible: any /v1/embeddings endpoint (OpenAI, Azure, self-hosted TEI/vLLM, etc.).
EMBEDDING_PROVIDER=local-hash
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ---- Object storage for original documents ----
# db (default): originals stored in Postgres (bytea). s3: any S3-compatible bucket (AWS, R2, Supabase Storage S3).
STORAGE_DRIVER=db
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Ingestion ----
MAX_UPLOAD_MB=50
# Comma-separated host allowlist for URL ingestion. Empty = any public host (private/loopback/metadata always blocked).
URL_INGEST_ALLOWED_HOSTS=
# Vercel Cron fallback processor: only jobs whose source is smaller than this are processed inside a serverless function.
CRON_MAX_JOB_BYTES=3000000
CRON_SECRET=replace-with-random-string
# Optional GitHub token (read-only) for repository ingestion rate limits.
GITHUB_TOKEN=

# ---- Signup policy ----
# open | invite (invite = only emails in ALLOWED_SIGNUP_EMAILS may register, including the first account; the first account becomes admin)
SIGNUP_MODE=open
ALLOWED_SIGNUP_EMAILS=
